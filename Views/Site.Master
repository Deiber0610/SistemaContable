<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="SistemaContable.SiteMaster" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server" /></title>
    <link href="Styles/Site.css" rel="stylesheet" type="text/css" />
</head>
<body>
    <form id="form1" runat="server">
        <div class="header">
            <h1>Sistema Contable</h1>
            <div class="menu">
                <asp:HyperLink ID="lnkCuentas" runat="server" NavigateUrl="~/Cuentas.aspx">Cuentas</asp:HyperLink> |
                <asp:HyperLink ID="lnkAsientos" runat="server" NavigateUrl="~/Asientos.aspx">Asientos</asp:HyperLink> |
                <asp:HyperLink ID="lnkMayor" runat="server" NavigateUrl="~/Mayor.aspx">Mayor</asp:HyperLink> |
                <asp:HyperLink ID="lnkBalanza" runat="server" NavigateUrl="~/Balanza.aspx">Balanza</asp:HyperLink> |
                <asp:HyperLink ID="lnkEstadoResultados" runat="server" NavigateUrl="~/EstadoResultados.aspx">Estado Resultados</asp:HyperLink> |
                <asp:HyperLink ID="lnkBalanceGeneral" runat="server" NavigateUrl="~/BalanceGeneral.aspx">Balance General</asp:HyperLink>
            </div>
        </div>

        <div class="body">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </div>

        <div class="footer">
            <p>; Proyecto Conta 2025 Sistema Contable Deiber-Brandon-Josue-Saimon</p>
        </div>
    </form>
</body>
</html>
